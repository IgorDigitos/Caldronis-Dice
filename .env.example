DISCORD_TOKEN=
DEV_GUILD_ID=
DATABASE_PATH=data/caldronis.sqlite3

# Ponte com o app Caldron Sheets (opcional). Sem FIREBASE_CREDENCIAL a ponte fica desligada.
# Arquivo da conta de serviço baixado do console do Firebase; guarde dentro de data/ (fora do git).
FIREBASE_CREDENCIAL=
# Webhooks do Discord: canal da mesa (todo mundo) e canal do Mestre (rolagens secretas).
WEBHOOK_MESA=
WEBHOOK_MESTRE=
